# CreatorChat — server environment (api + worker + db scripts).
# Copy to `.env` and fill in local values. `.env` is git-ignored; never commit real values.
# Everything here is SERVER-ONLY. Browser-visible values live in apps/*/.env.example (VITE_*).
# Placeholders such as <set-locally> count as "not set": the apps start without Telegram/R2/AI
# and log which integrations are unconfigured.

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Database & Redis ------------------------------------------------------
# Local PostgreSQL role/password come from scripts/setup-postgres.sql (change the password there).
DATABASE_URL=postgresql://creatorchat:creatorchat@localhost:5432/creatorchat
# Separate database for integration tests. Must end in `_test` and be on localhost.
DATABASE_URL_TEST=postgresql://creatorchat:creatorchat@localhost:5432/creatorchat_test
REDIS_URL=redis://localhost:6379

# --- API -------------------------------------------------------------------
API_PORT=3000
# webhook target (Telegram needs public HTTPS)
API_PUBLIC_URL=https://<tunnel-or-domain>
# CORS allowlist: miniapp, admin
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Telegram (optional in dev) -------------------------------------------
# secret. Mini App login needs it plus USER_SESSION_SECRET; locally any value works with `pnpm telegram:initdata`
TELEGRAM_BOT_TOKEN=<set-locally>
TELEGRAM_BOT_USERNAME=<bot_username>
# secret
TELEGRAM_WEBHOOK_SECRET=<random-32+-chars>
# initData freshness window (confirm)
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
MINIAPP_URL=https://<tunnel-or-domain>

# --- Secrets (distinct per purpose; >= 32 random bytes) -------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
USER_SESSION_SECRET=<random 32+ bytes>
# the two admin secrets are required for admin login and must differ from each other
ADMIN_ACCESS_TOKEN_SECRET=<random 32+ bytes>
ADMIN_REFRESH_TOKEN_SECRET=<random 32+ bytes>
# encrypts secrets saved from the dashboard
MASTER_ENCRYPTION_KEY=<random 32 bytes, base64>

# --- Admin cookies ---------------------------------------------------------
# true behind HTTPS
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Cloudflare R2 (optional in dev; later phases) -------------------------
R2_ACCOUNT_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET=<bucket>
# secret
R2_ACCESS_KEY_ID=<set-locally>
# secret
R2_SECRET_ACCESS_KEY=<set-locally>

# --- AI (later phases; `fake` until a provider is chosen) ------------------
AI_PROVIDER=fake
AI_MODEL=
# secret
AI_API_KEY=<set-locally>

# --- Seed only (pnpm db:seed) ----------------------------------------------
# If SEED_ADMIN_PASSWORD is empty, a random password is generated and printed once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
