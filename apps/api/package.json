{
  "name": "@creatorchat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@creatorchat/backend-core": "workspace:*",
    "@creatorchat/contracts": "workspace:*",
    "@creatorchat/db": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "fastify": "5.12.8",
    "grammy": "1.46.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "concurrently": "9.2.1",
    "jose": "6.2.17",
    "unplugin-swc": "2.0.0"
  }
}
