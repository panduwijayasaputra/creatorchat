{
  "name": "@creatorchat/backend-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "telegram:initdata": "tsx scripts/telegram-initdata.ts"
  },
  "dependencies": {
    "@creatorchat/contracts": "workspace:*",
    "@creatorchat/db": "workspace:*",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "ioredis": "6.0.0",
    "tsx": "4.23.15"
  }
}
